{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1240px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "paper",
          "name": "Paper",
          "color": "#F5F1E8"
        },
        {
          "slug": "paper-2",
          "name": "Paper (deep)",
          "color": "#ECE6D8"
        },
        {
          "slug": "white",
          "name": "Warm white",
          "color": "#FFFDF8"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#1C2E24"
        },
        {
          "slug": "ink-soft",
          "name": "Ink (soft)",
          "color": "#4A5A4F"
        },
        {
          "slug": "forest",
          "name": "Forest",
          "color": "#1F3A2B"
        },
        {
          "slug": "leaf",
          "name": "Leaf",
          "color": "#6E8B4E"
        },
        {
          "slug": "leaf-text",
          "name": "Leaf (text)",
          "color": "#55703A"
        },
        {
          "slug": "beet",
          "name": "Beetroot",
          "color": "#A3204E"
        },
        {
          "slug": "beet-soft",
          "name": "Beetroot (soft)",
          "color": "#F3DCE4"
        },
        {
          "slug": "line",
          "name": "Line",
          "color": "#D9D1BF"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "serif",
          "name": "Newsreader",
          "fontFamily": "\"Newsreader\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Newsreader",
              "fontStyle": "normal",
              "fontWeight": "300 600",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/newsreader-latin.woff2"
              ]
            },
            {
              "fontFamily": "Newsreader",
              "fontStyle": "italic",
              "fontWeight": "300 500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/newsreader-italic-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "sans",
          "name": "Instrument Sans",
          "fontFamily": "\"Instrument Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Instrument Sans",
              "fontStyle": "normal",
              "fontWeight": "400 600",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/instrument-sans-latin.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "15px"
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "17px"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(19px, 1.6vw, 21px)"
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "clamp(34px, 4vw, 54px)"
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "clamp(44px, 6vw, 84px)"
        }
      ]
    },
    "spacing": {
      "padding": true,
      "units": [
        "px",
        "%",
        "rem",
        "vw"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65"
    },
    "spacing": {
      "padding": {
        "left": "clamp(16px,4vw,48px)",
        "right": "clamp(16px,4vw,48px)"
      },
      "blockGap": "24px"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "400",
          "lineHeight": "1.08",
          "letterSpacing": "-0.015em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "lineHeight": "1.02",
          "letterSpacing": "-0.02em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(24px, 2.2vw, 30px)",
          "lineHeight": "1.2"
        }
      },
      "link": {
        "color": {
          "text": "currentColor"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--forest)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": {
          "radius": "999px"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontWeight": "600",
          "fontSize": "15px",
          "lineHeight": "1"
        },
        "spacing": {
          "padding": {
            "top": "16px",
            "bottom": "16px",
            "left": "24px",
            "right": "24px"
          }
        },
        ":hover": {
          "color": {
            "background": "#2C4C39"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
